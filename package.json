{
  "name": "@zthun/spellcraft-library",
  "version": "0.0.0",
  "description": "Basic web component libraries and helpers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/spellcraft"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf --glob 'dist' 'reports' 'coverage' '*.tgz' '*.log' 'packages/**/dist' 'packages/**/docs' 'packages/**/*.tgz' 'packages/**/*.log' 'packages/**/.certificates' 'packages/**/stats'",
    "test": "vitest --run --coverage",
    "lint": "lint-janitor",
    "check": "tsc --noEmit",
    "build": "lerna run build",
    "make": "yarn clean && yarn lint && yarn check && yarn test && yarn build",
    "prepare": "husky"
  },
  "author": "Anthony Bonta",
  "devDependencies": {
    "@commitlint/cli": "^19.6.1",
    "@commitlint/config-conventional": "^19.6.0",
    "@types/lodash-es": "^4.17.12",
    "@vitest/coverage-istanbul": "^2.1.8",
    "@zthun/lint-janitor": "^18.0.5",
    "@zthun/lint-janitor-config": "^18.0.5",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lerna": "^8.1.9",
    "rimraf": "^6.0.1",
    "rollup-plugin-visualizer": "^5.13.1",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-checker": "^0.8.0",
    "vite-plugin-dts": "^4.4.0",
    "vite-plugin-externalize-deps": "^0.8.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  },
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "yarn@4.6.0"
}
