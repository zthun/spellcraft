{
  "name": "@zthun/spellcraft-library",
  "version": "0.0.0",
  "description": "Basic web component libraries and helpers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/spellcraft"
  },
  "private": true,
  "scripts": {
    "clean": "rimraf --glob 'dist' 'reports' 'coverage' '*.tgz' '*.log' 'packages/**/dist' 'packages/**/docs' 'packages/**/*.tgz' 'packages/**/*.log' 'packages/**/.certificates' 'packages/**/stats'",
    "test": "vitest --run --coverage",
    "lint": "lint-janitor",
    "check": "tsc --noEmit",
    "build": "lerna run build",
    "make": "yarn clean && yarn lint && yarn check && yarn test && yarn build",
    "postinstall": "husky install"
  },
  "author": "Anthony Bonta",
  "devDependencies": {
    "@commitlint/cli": "^19.2.1",
    "@commitlint/config-conventional": "^19.1.0",
    "@types/lodash-es": "^4.17.12",
    "@vitest/coverage-istanbul": "^1.4.0",
    "@zthun/lint-janitor": "^16.1.0",
    "@zthun/lint-janitor-config": "^16.1.0",
    "husky": "^9.0.11",
    "jsdom": "^24.0.0",
    "lerna": "~8.1.2",
    "rimraf": "^5.0.5",
    "rollup-plugin-visualizer": "^5.12.0",
    "typescript": "~5.4.5",
    "vite": "^5.2.8",
    "vite-plugin-checker": "^0.6.4",
    "vite-plugin-dts": "^3.8.1",
    "vite-plugin-externalize-deps": "^0.8.0",
    "vite-tsconfig-paths": "^4.3.2",
    "vitest": "^1.4.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "yarn@4.1.1"
}
