{
  "name": "spellcraft",
  "version": "0.0.0",
  "description": "Style checks with tools for web projects using common rules.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/spellcraft"
  },
  "private": true,
  "scripts": {
    "clean": "rimraf 'packages/**/dist' 'packages/**/coverage' 'packages/**/*.tgz'",
    "test": "lerna run test",
    "lint": "lint-janitor",
    "build": "lerna run build",
    "bundle": "lerna run bundle",
    "make": "yarn clean && yarn lint && yarn test && yarn build",
    "postinstall": "husky install"
  },
  "author": "Anthony Bonta",
  "devDependencies": {
    "@commitlint/cli": "^19.2.1",
    "@commitlint/config-conventional": "^19.1.0",
    "@zthun/lint-janitor": "^16.0.0",
    "@zthun/lint-janitor-config": "^16.0.1",
    "husky": "^9.0.11",
    "lerna": "~8.1.2",
    "rimraf": "^5.0.5",
    "typescript": "~5.4.3",
    "vitest": "^1.4.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "yarn@4.1.1"
}
