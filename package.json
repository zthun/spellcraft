{
  "name": "@zthun/spellcraft-library",
  "version": "0.0.0",
  "description": "Basic web component libraries and helpers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zthun/spellcraft"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rimraf --glob 'dist' 'reports' 'coverage' '*.tgz' '*.log' 'packages/**/dist' 'packages/**/docs' 'packages/**/*.tgz' 'packages/**/*.log' 'packages/**/.certificates' 'packages/**/stats'",
    "test": "vitest --run --coverage",
    "lint": "lint-janitor",
    "check": "tsc --noEmit",
    "build": "lerna run build",
    "make": "yarn clean && yarn lint && yarn check && yarn test && yarn build",
    "prepare": "husky"
  },
  "author": "Anthony Bonta",
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@types/lodash-es": "^4.17.12",
    "@vitest/coverage-istanbul": "^3.1.4",
    "@zthun/lint-janitor": "^18.1.0",
    "@zthun/lint-janitor-config": "^18.1.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lerna": "^8.2.2",
    "rimraf": "^6.0.1",
    "rollup-plugin-visualizer": "^6.0.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-checker": "^0.9.3",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-external": "^6.2.2",
    "vite-plugin-externalize-deps": "^0.9.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.1.4"
  },
  "workspaces": [
    "packages/*"
  ],
  "packageManager": "yarn@4.9.1"
}
